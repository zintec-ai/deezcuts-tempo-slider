{
  "manifest_version": 3,
  "name": "Deezcuts Tempo Slider",
  "description": "DJ-style tempo fader for the deezcuts.io players: live BPM, ±6/±10/±16/WIDE ranges, and key lock (Master Tempo).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://w.soundcloud.com/player/*"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://w.soundcloud.com/player/*"
      ],
      "js": [
        "protocol.js",
        "ui.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://deezcuts.io/*",
        "https://*.deezcuts.io/*"
      ],
      "js": [
        "protocol.js",
        "fader.js",
        "site_controller.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
